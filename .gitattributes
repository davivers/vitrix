# Tudo em LF, inclusive no Windows: o CI recompila a interface no Linux e compara com o build commitado.
* text=auto eol=lf

*.woff2 binary
*.woff binary
*.png binary
*.jpg binary
*.ico binary

# Built UI and sources: always LF (the CI rebuilds on Linux and diffs src/vitrix/ui/).
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.svg text eol=lf
